import numpy as np
import cv2
import matplotlib.pyplot as plt
from matplotlib.widgets import Slider, RadioButtons
from scipy.fftpack import fft2, ifft2, fftshift, ifftshift

class InteractiveFilteringSystem:
    def __init__(self, image_path):
        # خواندن و نرمال‌سازی تصویر
        self.original_image = cv2.imread(image_path, cv2.IMREAD_GRAYSCALE)
        if self.original_image is None:
            raise ValueError(f"Cannot load image from {image_path}")
        
        # نرمال‌سازی به بازه [0, 1]
        self.original_image = self.original_image.astype(np.float64) / 255.0
        
        self.rows, self.cols = self.original_image.shape
        
        # محاسبه FFT تصویر اصلی
        self.f_transform = fft2(self.original_image)
        self.f_shift = fftshift(self.f_transform)
        
        # پارامترهای اولیه
        self.cutoff = 30
        self.order = 2
        self.gamma_low = 0.5
        self.gamma_high = 1.5
        self.filter_type = 'Ideal Lowpass'
        
        # ایجاد رابط کاربری
        self.setup_ui()
        self.update_filter()
        
    def setup_ui(self):
        """ایجاد رابط کاربری تعاملی"""
        self.fig = plt.figure(figsize=(16, 10))
        
        # تنظیم فضای subplotها به صورت دستی
        self.fig.subplots_adjust(left=0.05, right=0.95, top=0.95, bottom=0.25, 
                                hspace=0.3, wspace=0.3)
        
        # ایجاد subplotها
        self.ax_original = plt.subplot(2, 4, 1)
        self.ax_filtered = plt.subplot(2, 4, 2)
        self.ax_mask = plt.subplot(2, 4, 3)
        self.ax_profile = plt.subplot(2, 4, 4)
        self.ax_hist_orig = plt.subplot(2, 4, 5)
        self.ax_hist_filt = plt.subplot(2, 4, 6)
        self.ax_metrics = plt.subplot(2, 4, 7)
        
        # نمایش تصویر اصلی
        self.ax_original.imshow(self.original_image, cmap='gray')
        self.ax_original.set_title('Original Image')
        self.ax_original.axis('off')
        
        # ایجاد sliderها
        ax_cutoff = plt.axes([0.15, 0.15, 0.3, 0.02])
        ax_order = plt.axes([0.15, 0.12, 0.3, 0.02])
        ax_gamma_low = plt.axes([0.15, 0.09, 0.3, 0.02])
        ax_gamma_high = plt.axes([0.15, 0.06, 0.3, 0.02])
        
        self.slider_cutoff = Slider(ax_cutoff, 'Cutoff Frequency', 1, 200, 
                                    valinit=self.cutoff, valstep=1)
        self.slider_order = Slider(ax_order, 'Filter Order', 1, 10, 
                                   valinit=self.order, valstep=1)
        self.slider_gamma_low = Slider(ax_gamma_low, 'Gamma Low', 0.1, 2.0, 
                                       valinit=self.gamma_low, valstep=0.1)
        self.slider_gamma_high = Slider(ax_gamma_high, 'Gamma High', 0.1, 2.0, 
                                        valinit=self.gamma_high, valstep=0.1)
        
        # اتصال sliderها به تابع به‌روزرسانی
        self.slider_cutoff.on_changed(self.on_slider_change)
        self.slider_order.on_changed(self.on_slider_change)
        self.slider_gamma_low.on_changed(self.on_slider_change)
        self.slider_gamma_high.on_changed(self.on_slider_change)
        
        # ایجاد دکمه‌های رادیویی برای انتخاب نوع فیلتر
        ax_radio = plt.axes([0.55, 0.06, 0.15, 0.12])
        self.radio = RadioButtons(ax_radio, 
                                  ('Ideal Lowpass', 'Ideal Highpass',
                                   'Butterworth Lowpass', 'Butterworth Highpass',
                                   'Gaussian Lowpass', 'Gaussian Highpass',
                                   'Homomorphic'))
        self.radio.on_clicked(self.on_filter_change)
        
    def create_filter_mask(self):
        """ایجاد ماسک فیلتر بر اساس نوع انتخاب شده"""
        crow, ccol = self.rows // 2, self.cols // 2
        
        # ایجاد شبکه مختصات
        u = np.arange(self.rows) - crow
        v = np.arange(self.cols) - ccol
        U, V = np.meshgrid(v, u)
        D = np.sqrt(U**2 + V**2)
        
        if self.filter_type == 'Ideal Lowpass':
            mask = (D <= self.cutoff).astype(float)
            
        elif self.filter_type == 'Ideal Highpass':
            mask = (D > self.cutoff).astype(float)
            
        elif self.filter_type == 'Butterworth Lowpass':
            mask = 1 / (1 + (D / self.cutoff)**(2 * self.order))
            
        elif self.filter_type == 'Butterworth Highpass':
            mask = 1 / (1 + (self.cutoff / (D + 1e-6))**(2 * self.order))
            
        elif self.filter_type == 'Gaussian Lowpass':
            mask = np.exp(-(D**2) / (2 * self.cutoff**2))
            
        elif self.filter_type == 'Gaussian Highpass':
            mask = 1 - np.exp(-(D**2) / (2 * self.cutoff**2))
            
        elif self.filter_type == 'Homomorphic':
            mask = (self.gamma_high - self.gamma_low) * \
                   (1 - np.exp(-(D**2) / (2 * self.cutoff**2))) + self.gamma_low
        
        return mask
    
    def apply_filter(self, mask):
        """اعمال فیلتر به تصویر"""
        # اعمال ماسک در حوزه فرکانس
        filtered_shift = self.f_shift * mask
        
        # تبدیل معکوس به حوزه مکان
        filtered_transform = ifftshift(filtered_shift)
        filtered_image = np.real(ifft2(filtered_transform))
        
        # نرمال‌سازی به بازه [0, 1]
        filtered_image = np.clip(filtered_image, 0, 1)
        
        return filtered_image
    
    def calculate_metrics(self, original, filtered):
        """محاسبه معیارهای کیفیت تصویر"""
        mse = np.mean((original - filtered)**2)
        
        if mse == 0:
            psnr = float('inf')
        else:
            psnr = 10 * np.log10(1.0 / mse)
        
        std_orig = np.std(original)
        std_filt = np.std(filtered)
        
        return {
            'MSE': mse,
            'PSNR': psnr,
            'Std Dev Original': std_orig,
            'Std Dev Filtered': std_filt
        }
    
    def update_filter(self):
        """به‌روزرسانی فیلتر و نمایش نتایج"""
        # ایجاد ماسک فیلتر
        mask = self.create_filter_mask()
        
        # اعمال فیلتر
        filtered_image = self.apply_filter(mask)
        
        # محاسبه معیارها
        metrics = self.calculate_metrics(self.original_image, filtered_image)
        
        # نمایش تصویر فیلتر شده
        self.ax_filtered.clear()
        self.ax_filtered.imshow(filtered_image, cmap='gray', vmin=0, vmax=1)
        self.ax_filtered.set_title('Filtered Image')
        self.ax_filtered.axis('off')
        
        # نمایش ماسک فیلتر - اصلاح شده
        self.ax_mask.clear() 
        im_mask = self.ax_mask.imshow(mask, cmap='gray', vmin=0, vmax=1)
        self.ax_mask.set_title('Filter Mask')
        self.ax_mask.axis('off')
        
        # نمایش پروفایل فیلتر
        self.ax_profile.clear()
        center_row = mask[self.rows // 2, :]
        self.ax_profile.plot(center_row)
        self.ax_profile.set_title('Filter Frequency Profile')
        self.ax_profile.set_xlabel('Frequency')
        self.ax_profile.set_ylabel('Magnitude')
        self.ax_profile.grid(True)
        self.ax_profile.set_ylim([0, 1.1])
        
        # نمایش هیستوگرام تصویر اصلی
        self.ax_hist_orig.clear()
        self.ax_hist_orig.hist(self.original_image.ravel(), bins=256, 
                              range=(0, 1), color='blue', alpha=0.7)
        self.ax_hist_orig.set_title('Original Histogram')
        self.ax_hist_orig.set_xlabel('Intensity')
        self.ax_hist_orig.set_ylabel('Frequency')
        
        # نمایش هیستوگرام تصویر فیلتر شده
        self.ax_hist_filt.clear()
        self.ax_hist_filt.hist(filtered_image.ravel(), bins=256, 
                              range=(0, 1), color='green', alpha=0.7)
        self.ax_hist_filt.set_title('Filtered Histogram')
        self.ax_hist_filt.set_xlabel('Intensity')
        self.ax_hist_filt.set_ylabel('Frequency')
        
        # نمایش معیارهای کیفیت
        self.ax_metrics.clear()
        self.ax_metrics.axis('off')
        metrics_text = 'Image Quality Metrics:\n\n'
        metrics_text += f"MSE: {metrics['MSE']:.6f}\n"
        metrics_text += f"PSNR: {metrics['PSNR']:.2f} dB\n"
        metrics_text += f"Std Dev Original: {metrics['Std Dev Original']:.4f}\n"
        metrics_text += f"Std Dev Filtered: {metrics['Std Dev Filtered']:.4f}"
        self.ax_metrics.text(0.1, 0.5, metrics_text, fontsize=10, 
                           verticalalignment='center', family='monospace')
        
        plt.draw()
    
    def on_slider_change(self, val):
        """تابع فراخوانی شده هنگام تغییر slider"""
        self.cutoff = int(self.slider_cutoff.val)
        self.order = int(self.slider_order.val)
        self.gamma_low = self.slider_gamma_low.val
        self.gamma_high = self.slider_gamma_high.val
        self.update_filter()
    
    def on_filter_change(self, label):
        """تابع فراخوانی شده هنگام تغییر نوع فیلتر"""
        self.filter_type = label
        self.update_filter()
    
    def show(self):
        plt.show()

