import cv2
import numpy as np
import matplotlib.pyplot as plt
from collections import deque

#Otsu
def otsu_manual(gray):
    hist = np.zeros(256, dtype=np.float64)

    for pixel in gray.ravel():
        hist[pixel] += 1

    total = gray.size
    prob = hist / total

    best_t = 0
    min_within_var = float("inf")

    for t in range(256):
        w1 = np.sum(prob[:t+1])
        w2 = np.sum(prob[t+1:])

        if w1 == 0 or w2 == 0:
            continue

        levels1 = np.arange(0, t+1)
        levels2 = np.arange(t+1, 256)

        mean1 = np.sum(levels1 * prob[:t+1]) / w1
        mean2 = np.sum(levels2 * prob[t+1:]) / w2

        var1 = np.sum(((levels1 - mean1) ** 2) * prob[:t+1]) / w1
        var2 = np.sum(((levels2 - mean2) ** 2) * prob[t+1:]) / w2

        within_var = w1 * var1 + w2 * var2

        if within_var < min_within_var:
            min_within_var = within_var
            best_t = t

    binary = np.zeros_like(gray)
    binary[gray > best_t] = 255

    return best_t, binary

seed_point = None

def mouse_callback(event, x, y, flags, param):
    global seed_point
    if event == cv2.EVENT_LBUTTONDOWN:
        seed_point = (x, y)
        print("Seed selected:", seed_point)

def region_growing_color(image, seed, threshold):
    h, w, c = image.shape
    mask = np.zeros((h, w), dtype=np.uint8)

    seed_x, seed_y = seed
    seed_value = image[seed_y, seed_x].astype(np.int32)

    queue = deque()
    queue.append((seed_x, seed_y))
    mask[seed_y, seed_x] = 255

    neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    while queue:
        x, y = queue.popleft()

        for dx, dy in neighbors:
            nx, ny = x + dx, y + dy

            if nx < 0 or ny < 0 or nx >= w or ny >= h:
                continue

            if mask[ny, nx] == 255:
                continue

            pixel_value = image[ny, nx].astype(np.int32)
            diff = np.linalg.norm(pixel_value - seed_value)

            if diff < threshold:
                mask[ny, nx] = 255
                queue.append((nx, ny))

    return mask

drawing = False
ix, iy = -1, -1
rect = None
temp_img = None

def draw_rectangle(event, x, y, flags, param):
    global ix, iy, drawing, rect, temp_img

    img = param

    if event == cv2.EVENT_LBUTTONDOWN:
        drawing = True
        ix, iy = x, y

    elif event == cv2.EVENT_MOUSEMOVE:
        if drawing:
            temp_img = img.copy()
            cv2.rectangle(temp_img, (ix, iy), (x, y), (0, 255, 0), 2)
            cv2.imshow("Draw rectangle", temp_img)

    elif event == cv2.EVENT_LBUTTONUP:
        drawing = False
        rect = (min(ix, x), min(iy, y), abs(x - ix), abs(y - iy))
        cv2.rectangle(img, (ix, iy), (x, y), (0, 255, 0), 2)
        cv2.imshow("Draw rectangle", img)
        print("Rectangle:", rect)

def run_grabcut(image):
    global rect

    clone = image.copy()
    cv2.imshow("Draw rectangle", clone)
    cv2.setMouseCallback("Draw rectangle", draw_rectangle, clone)
    cv2.waitKey(0)
    cv2.destroyAllWindows()

    mask = np.zeros(image.shape[:2], np.uint8)

    bgd_model = np.zeros((1, 65), np.float64)
    fgd_model = np.zeros((1, 65), np.float64)

    cv2.grabCut(image, mask, rect, bgd_model, fgd_model, 5, cv2.GC_INIT_WITH_RECT)

    sure_bg = np.where(mask == cv2.GC_BGD, 255, 0).astype(np.uint8)
    probable_bg = np.where(mask == cv2.GC_PR_BGD, 255, 0).astype(np.uint8)
    sure_fg = np.where(mask == cv2.GC_FGD, 255, 0).astype(np.uint8)
    probable_fg = np.where(mask == cv2.GC_PR_FGD, 255, 0).astype(np.uint8)

    final_mask = np.where(
        (mask == cv2.GC_FGD) | (mask == cv2.GC_PR_FGD),
        255,
        0
    ).astype(np.uint8)

    result = image.copy()
    result[final_mask == 0] = 0

    return sure_bg, probable_bg, sure_fg, probable_fg, final_mask, result

# IoU

def calculate_iou(pred_mask, gt_mask):
    pred = pred_mask > 0
    gt = gt_mask > 0

    intersection = np.logical_and(pred, gt).sum()
    union = np.logical_or(pred, gt).sum()

    if union == 0:
        return 0

    return intersection / union

